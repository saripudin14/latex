journal = {Asian Journal of Research in Computer Science},
keywords = {1-7,2,2018,45051,__________________________________________________,ajrcos,article no,bigdata,campus,city,cloud computing,com,corresponding author,e-mail,nachandiya,nachandiya et al,network,smart campus,yahoo},
number = {2},
