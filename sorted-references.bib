journal = {International Journal of Engineering Research and},
keywords = {bageshree pathak,department of electronics,dr,software testing,software testing life cycle,software testing techniques,strategies,telecommunication},
number = {08},
pages = {817--822},
title = {{Comprehensive Study of Software Testing Techniques and Strategies: A Review}},
volume = {V9},
year = {2020}
}
@article{Pratama2025,
abstract = {Pengembangan backend API yang efisien sangat penting dalam mendukung aplikasi web modern. Namun, pemilihan bahasa pemrograman dan metode query yang optimal masih menjadi tantangan bagi pengembang. Penelitian ini bertujuan untuk membandingkan kinerja backend RESTful API yang dibangun menggunakan tiga bahasa pemrograman (Go, PHP, dan JavaScript) serta empat metode pengambilan data (Raw SQL, ORM, Query Builder, dan Stored Procedure). Metode penelitian yang digunakan adalah kuantitatif true-experimental, dengan pengujian Load Testing, Spike Testing, dan Stress Testing untuk mengevaluasi jumlah permintaan yang berhasil, penggunaan CPU, dan penggunaan memori. Hasil pengujian menunjukkan bahwa Go dengan Raw SQL memiliki kinerja tertinggi dalam jumlah permintaan, waktu respons, dan penanganan beban, diikuti oleh Node.js, sementara PHP memiliki kinerja terendah.   Kata kunci: Backend API, Pengujian Kinerja, Metode Query},
