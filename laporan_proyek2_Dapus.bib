@article{Nachandiya2018,
   abstract = {The increasing development of intelligent technologies offer opportunities for objects in the real world to communicate using sensors and communication networks. One of the application areas is the smart campus for the smart information system. The construction of the smart campus based on smart technologies such as Bigdata, cloud computing, mobile computing, network infrastructure needs the understanding and the exploration of these technologies in the development process. This conceptual paper explored the roles of smart technologies in developing a smart campus. Analysis of the key concepts; the architectural layers for the smart campus were proposed hoping to promote smart campus information system for a sustainable intelligent campus. The concept could be a platform for developing smart city in a developing context.},
